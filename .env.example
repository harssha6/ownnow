# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.

# The public hostname your sites live under (Caddy gets TLS for it).
# Sites will be at https://<OWNNOW_DOMAIN>/{slug}/ — or with a wildcard
# DNS record + OWNNOW_BASE_DOMAIN below, https://{slug}.<domain>/
OWNNOW_DOMAIN=now.example.com
OWNNOW_PUBLIC_URL=https://now.example.com

# Publish auth: one bearer key. Generate it yourself:
#   openssl rand -hex 32
# Anyone with this key can publish/update/delete sites. Keep it secret.
OWNNOW_API_KEY=

# Long random secret for password-site cookies / upload tokens.
OWNNOW_SECRET=

# Storage: "local" (Docker volume) or "s3" (Cloudflare R2 / S3 / MinIO).
OWNNOW_STORAGE=local
OWNNOW_DATA_DIR=/data
# For s3:
# OWNNOW_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OWNNOW_S3_BUCKET=ownnow
# OWNNOW_S3_REGION=auto
# OWNNOW_S3_ACCESS_KEY=
# OWNNOW_S3_SECRET_KEY=

# Optional: {slug}.<base-domain> mode (needs wildcard DNS to your host).
# OWNNOW_BASE_DOMAIN=example.com
